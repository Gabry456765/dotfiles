{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "height": 18
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[36m    コンピューター"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "   OS",
            "keyColor": "white"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "white"
        },
        {
            "type": "packages",
            "key": "   Packages",
            "keyColor": "white"
        },
        {
            "type": "display",
            "key": "   Display",
            "keyColor": "white"
        },
        {
            "type": "wm",
            "key": "   WM",
            "keyColor": "white"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "title",
            "key": "  ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "   CPU",
            "keyColor": "white"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": "   GPU",
            "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "  ﬙ Memory",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },
        "break"
    ]
}
